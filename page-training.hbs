{{!< default}}

{{!-- Ghost picks this up automatically for the page with the slug "training".
      The page's own content is editable in Ghost as usual; the dashboard is
      appended beneath it. --}}

{{#post}}

    <header class="training-page__header">
        {{#if @page.show_title_and_feature_image}}
        <h1 class="training-page__title">{{title}}</h1>
        {{/if}}

        <div class="training-page__intro prose">
            {{content}}
        </div>
    </header>

    {{> training-dashboard}}

{{/post}}
