{{!< default}}
{{#contentFor "title"}}{{tag.name}}{{#if pagination.prev}} (Page {{pagination.page}}){{/if}} — {{@site.title}}{{/contentFor}}

{{#tag}}

    <h1>
        Blog/<span class="color--text-subtle">{{name}}</span> {{#if ../pagination.prev}}<span class="color--text-subtle">(Page {{../pagination.page}})</span>{{/if}}
    </h1>

    {{#if description}}
    <p class="tag__description">{{description}}</p>
    {{/if}}

{{/tag}}

{{> tags currentTag=tag.slug}}

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>

{{> pagination}}
