{{!< default}}
{{#contentFor "title"}}{{tag.name}} — {{@site.title}}{{/contentFor}}

<header class="archive-header">
    {{#tag}}

        <h1 class="archive-header__title">
            Archive/<span class="archive-header__page">{{name}}</span>
        </h1>

        {{#if description}}
        <p class="archive-header__description">{{description}}</p>
        {{/if}}

    {{/tag}}

    {{> tags currentTag=tag.slug}}
</header>

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>
