{{!< default}}
{{#contentFor "title"}}{{tag.name}}{{#if pagination.prev}} (Page {{pagination.page}}){{/if}} — {{@site.title}}{{/contentFor}}

<header class="archive-header">
    {{#tag}}

        <h1 class="archive-header__title">
            Blog/<span class="archive-header__page">{{name}}</span> {{#if ../pagination.prev}}<span class="archive-header__page">(Page {{../pagination.page}})</span>{{/if}}
        </h1>

        {{#if description}}
        <p class="archive-header__description">{{description}}</p>
        {{/if}}

    {{/tag}}

    {{> tags currentTag=tag.slug}}
</header>

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>

{{> pagination}}
