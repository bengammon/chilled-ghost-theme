{{!< default}}
{{#contentFor "title"}}Blog{{#if pagination.prev}} (Page {{pagination.page}}){{/if}} — {{@site.title}}{{/contentFor}}

<header class="archive-header">
    <h1 class="archive-header__title">Blog {{#if pagination.prev}}<span class="archive-header__page">(Page {{pagination.page}})</span>{{/if}}</h1>

    {{> tags}}
</header>

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>

{{> pagination}}
