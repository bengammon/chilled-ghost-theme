{{!< default}}

<div class="home">

    {{#is "home"}}
    <section class="intro">
        <h1 class="intro__heading">Hi, I'm Ben. <br>Creative developer.<br><span class="intro__muted">Web building since 2007.</span></h1>

        <p class="intro__text">I've spent nearly 20 years building for the web, including websites for major game franchises like <em>No Man's Sky</em>, <em>Dead Island</em>, <em>Saints Row</em>, and <em>Fable Legends (RIP)</em>. This is my personal site and microblog: a stream of what I'm learning, making, playing, and thinking about.</p>

        <a class="home-link" href="/about">More about me →</a>
    </section>
    {{/is}}

    <section class="home-section">
        <h2 class="home-section__label">Recent writing</h2>

        <div class="home-section__rows">
            {{#get "posts" include="tags" filter="tag:-note" limit="5"}}
                {{#foreach posts}}
                    {{> post-teaser}}
                {{/foreach}}
            {{/get}}
        </div>

        <a class="home-link home-link--muted" href="/archive/">See more of my writing →</a>
    </section>

    {{!-- Hidden until assets/js/training.js has loaded the training data and
          filled the summary; if the data is missing or slow, the section never
          appears. --}}
    <section class="home-section" data-training-summary hidden>
        <h2 class="home-section__label">Training</h2>

        <div class="js-training-summary"></div>

        <a class="home-link" href="/training/">View training log →</a>
    </section>

    <section class="home-section">
        <h2 class="home-section__label">Notes</h2>

        <div class="home-section__rows">
            {{#get "posts" include="tags" filter="tag:note" limit="2"}}
                {{#foreach posts}}
                    {{> post-teaser}}
                {{/foreach}}
            {{/get}}
        </div>

        <a class="home-link home-link--muted" href="/tag/note/">See more of my notes →</a>
    </section>

</div>
