{{!< default}}
{{#contentFor "title"}}{{#author}}{{name}}{{/author}}{{#if pagination.prev}} (Page {{pagination.page}}){{/if}} — {{@site.title}}{{/contentFor}}

<header class="archive-header">
    {{#author}}

        <h1 class="archive-header__title">
            Blog/<span class="archive-header__page">{{name}}</span> {{#if ../pagination.prev}}<span class="archive-header__page">(Page {{../pagination.page}})</span>{{/if}}
        </h1>

        {{#if bio}}
        <p class="archive-header__description">{{bio}}</p>
        {{/if}}

    {{/author}}
</header>

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>

{{> pagination}}
