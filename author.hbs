{{!< default}}
{{#contentFor "title"}}{{#author}}{{name}}{{/author}}{{#if pagination.prev}} (Page {{pagination.page}}){{/if}} — {{@site.title}}{{/contentFor}}

{{#author}}

    <h1>
        Blog/<span class="color--text-subtle">{{name}}</span> {{#if ../pagination.prev}}<span class="color--text-subtle">(Page {{../pagination.page}})</span>{{/if}}
    </h1>

    {{#if bio}}
    <p class="author__description">{{bio}}</p>
    {{/if}}

{{/author}}

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>

{{> pagination}}
