{{!< default}}
{{#contentFor "title"}}{{#author}}{{name}}{{/author}} — {{@site.title}}{{/contentFor}}

<header class="archive-header">
    {{#author}}

        <h1 class="archive-header__title">
            Archive/<span class="archive-header__page">{{name}}</span>
        </h1>

        {{#if bio}}
        <p class="archive-header__description">{{bio}}</p>
        {{/if}}

    {{/author}}
</header>

<div class="archive">
    {{#foreach posts}}
        {{> post-teaser}}
    {{/foreach}}
</div>
