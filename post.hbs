{{!< default}}

{{#post}}

<article class="{{post_class}}{{#has tag="note"}} post--note{{/has}}" data-post-date="{{published_at}}" data-post-id="{{id}}">

    {{!-- One grid for the whole post: the reading column in the middle and,
          on wide screens, the contents list in the left margin. On narrow
          screens everything stacks in source order: header, contents, body. --}}
    <div class="post__layout">

        <header class="post__header">
            <h1 class="post__title">{{title}} <span class="post__number js-post-number" style="opacity: 0;"></span></h1>

            {{!-- Notes carry their meta under the text instead (below). --}}
            {{^has tag="note"}}
                {{> "post-meta" readingTime=true}}
            {{/has}}
        </header>

        {{#has tag="#toc"}}
            {{> "table-of-contents"}}
        {{/has}}

        {{!-- js-toc-content scopes tocbot to the post body, so the title above
             it is never picked up as a heading. --}}
        <div class="post__body prose js-toc-content">
            {{content}}
        </div>

        {{#has tag="note"}}
            <footer class="post__footer">
                {{> "post-meta"}}
            </footer>
        {{/has}}

    </div>

    {{!-- {{^has tag="note"}}
    <div class="post__subscribe">
        {{^if @member}}
        <hr>
        <div class="subscribe-cta">
            <p>Enjoyed this? I write about CSS, web development, gaming, and whatever else catches my eye. Subscribe to get new posts by email — no spam, unsubscribe any time.</p>
            <form data-members-form="subscribe" class="subscribe-cta__form">
                <input class="subscribe-cta__input" data-members-email type="email" placeholder="your@email.com" required />
                <button class="btn subscribe-cta__btn" type="submit">Subscribe</button>
                <div class="subscribe-cta__success" style="display:none">✓ You're subscribed!</div>
                <div class="subscribe-cta__error" style="display:none">Something went wrong. Please try again.</div>
            </form>
        </div>
        {{/if}}
    </div>
    {{/has}} --}}
</article>

{{/post}}
