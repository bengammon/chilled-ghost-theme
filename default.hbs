<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#131312" media="(prefers-color-scheme: dark)">

    {{!-- Re-applies a theme the visitor picked with the header button before
          anything paints, so a stored choice never flashes the system theme
          first. Kept inline and tiny for that reason; assets/js/theme.js does
          the rest. The two colours match --colorBg in variables/_color.scss. --}}
    <script>
        try {
            var theme = localStorage.getItem('theme');
            if (theme === 'light' || theme === 'dark') {
                document.documentElement.setAttribute('data-theme', theme);
                document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
                    meta.setAttribute('content', theme === 'dark' ? '#131312' : '#f6f5f1');
                });
            }
        } catch (e) {}
    </script>

    <link rel="stylesheet" href="{{asset "built/index.css"}}" />

    <title>{{#block "title"}}{{meta_title}}{{#is "post, page"}} — {{@site.title}}{{/is}}{{/block}}</title>

    {{ghost_head}}
    {{!-- Outputs important meta data and settings, should always be in <head> --}}

    {{!-- JSON-LD Structured Data --}}
    {{#is "home"}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebSite",
                "@id": "{{@site.url}}/#website",
                "url": "{{@site.url}}",
                "name": "{{@site.title}}",
                "description": "{{@site.description}}",
                "inLanguage": "en-GB"
            },
            {
                "@type": "Person",
                "@id": "{{@site.url}}/#person",
                "name": "Ben Gammon",
                "url": "{{@site.url}}",
                "description": "Creative developer with nearly 20 years of experience building for the web, including game titles such as No Man's Sky, Dead Island, and Saints Row.",
                "jobTitle": "Creative Developer",
                "worksFor": {
                    "@type": "Organization",
                    "name": "Etch"
                },
                "sameAs": [
                    "https://bsky.app/profile/bengammon.co.uk",
                    "https://www.linkedin.com/in/bengammon/"
                ]
            }
        ]
    }
    </script>
    {{/is}}

    {{#is "post"}}
    {{#post}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{{title}}",
        "url": "{{url absolute="true"}}",
        "datePublished": "{{date format="YYYY-MM-DDTHH:mm:ssZ"}}",
        "dateModified": "{{date updated_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
        "author": {
            "@type": "Person",
            "name": "Ben Gammon",
            "@id": "{{@site.url}}/#person"
        },
        "publisher": {
            "@type": "Person",
            "name": "Ben Gammon",
            "url": "{{@site.url}}"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{url absolute="true"}}"
        }{{#if feature_image}},
        "image": "{{feature_image}}"{{/if}}
    }
    </script>
    {{/post}}
    {{/is}}

</head>
<body class="{{body_class}}">

{{> header}}

<main class="main width" id="main" tabindex="-1">

    {{{body}}}
    {{!-- All content gets inserted here, index.hbs, post.hbs, etc --}}

</main>

{{> footer}}

<div class="blur"></div>

{{!-- <foot> --}}
<script src="{{asset "built/index.js"}}"></script>

{{ghost_foot}}
{{!-- Outputs important scripts - should always be included before closing body tag --}}

</body>
</html>
