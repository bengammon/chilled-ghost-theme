<nav class="pagination" role="navigation" aria-label="Pagination">
    {{#if pagination.prev}}
        <a class="pagination__link pagination__link--newer" href="{{page_url pagination.prev}}">&larr; Newer posts</a>
    {{/if}}
    <span class="pagination__page">Page {{pagination.page}} of {{pagination.pages}}</span>
    {{#if pagination.next}}
        <a class="pagination__link pagination__link--older" href="{{page_url pagination.next}}">Older posts &rarr;</a>
    {{/if}}
</nav>
