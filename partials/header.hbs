<header class="header column" role="banner">
    <a href="#main" class="skip-link">
        Skip to main content
    </a>

    <a class="header__logo" href="/">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 64 64"><path class="header__logo-bar" fill="currentColor" d="M20 20h24v8H20z"/><path fill="currentColor" d="M20 28c-6.627 0-12 5.373-12 12s5.373 12 12 12h8v-8h-8a4 4 0 0 1 0-8h16v24H20C8.954 60 0 51.046 0 40s8.954-20 20-20zM53 4.041C59.16 4.549 64 9.709 64 16c0 3.074-1.158 5.877-3.059 8A11.95 11.95 0 0 1 64 32c0 6.627-5.373 12-12 12H40l4-8h8a4 4 0 0 0 0-8h-8v-8h8a4 4 0 0 0 0-8H36v16l-8 4V4h25z"/></svg>
        <span class="visually-hidden">Home</span>
    </a>

    <div class="header__actions">

        {{!-- Inline on wider screens; on a phone it becomes the panel the Menu
              button opens (assets/js/menuOpen.js). --}}
        <div class="header__menu" id="site-menu">
            {{navigation}}
        </div>

        <button class="icon-button" type="button" data-ghost-search>
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" width="18" height="18" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10a7 7 0 1 0 14 0 7 7 0 0 0-14 0ZM21 21l-6-6"/></svg>
            <span class="visually-hidden">Search</span>
        </button>

        <button class="header__menu-button gh-burger" type="button" aria-controls="site-menu" aria-expanded="false">
            <svg class="header__burger" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" width="20" height="20" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>
            <svg class="header__close" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" width="20" height="20" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/></svg>
            Menu
        </button>

        {{!-- Switches between the light and dark themes. The choice is stored and
              re-applied by the inline script in default.hbs; see assets/js/theme.js. --}}
        <button class="icon-button js-theme-toggle" type="button" aria-pressed="false">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
            <span class="visually-hidden">Dark theme</span>
        </button>

    </div>
</header>
