<article class="post-teaser {{post_class}} post-year-{{date format='Y'}}" data-post-date="{{published_at}}" data-post-id="{{id}}">

    <time class="post-teaser__date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="DD/MM/YYYY"}}</time>

    <h2 class="post-teaser__heading"><a class="post-teaser__title" href="{{url}}">{{title}}</a>{{#if featured}} <span class="post-teaser__featured"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.9998 17.75L5.82784 20.995L7.00684 14.122L2.00684 9.25501L8.90684 8.25501L11.9928 2.00201L15.0788 8.25501L21.9788 9.25501L16.9788 14.122L18.1578 20.995L11.9998 17.75Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Featured</span></span>{{/if}} <span class="post-teaser__number js-post-number" style="opacity: 0;"></span></h2>

</article>
