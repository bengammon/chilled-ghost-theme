<article class="post-teaser {{post_class}} post-year-{{date format='Y'}}" data-post-date="{{published_at}}" data-post-id="{{id}}">

    <time class="post-teaser__date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="DD/MM/YYYY"}}</time>

    <h2 class="post-teaser__heading"><a class="post-teaser__title" href="{{url}}">{{title}}</a> <span class="post-teaser__number js-post-number" style="opacity: 0;"></span></h2>

</article>
