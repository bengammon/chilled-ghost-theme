# Copy to .env on the droplet (chmod 600). Never commit the real file.

# hevy.com/settings?developer — requires Hevy Pro
HEVY_API_KEY=

# Brevo, already configured for the site
BREVO_API_KEY=
ALERT_EMAIL_TO=hello@bengammon.co.uk
ALERT_EMAIL_FROM=hello@bengammon.co.uk

# External dead-man's switch. Without this, a cron that stops running is invisible.
HEALTHCHECKS_URL=

# Optional overrides
# HEVY_DATA_DIR=/var/www/hevy
# PUBLIC_STATS_URL=https://bengammon.co.uk/training.json
